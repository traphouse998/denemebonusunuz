{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {},
  "deploy": {
    "startCommand": "gunicorn app:app --bind 0.0.0.0:$PORT --workers 1 --threads 4 --worker-class gthread --timeout 60 --max-requests 2000 --max-requests-jitter 200",
